# 机场代理 (jichangdaili.world) 环境变量配置示例
# 复制为 .env 使用，严禁提交包含真实敏感凭据的 .env 文件至代码仓库

# 基础站点域名（生产规范URL）
VITE_SITE_URL=https://jichangdaili.world

# Algolia DocSearch 生产搜索配置（待获批后填入）
VITE_ALGOLIA_APP_ID=YOUR_APP_ID
VITE_ALGOLIA_SEARCH_KEY=YOUR_SEARCH_ONLY_API_KEY
VITE_ALGOLIA_INDEX_NAME=jichangdaili_world

# 部署与分析（可选受控配置）
VITE_ANALYTICS_ENABLED=false
