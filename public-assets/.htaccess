# 机场代理 (jichangdaili.world) Apache .htaccess 生产配置文件
# 适用环境: Apache 2.4+ (需开启 mod_rewrite, mod_headers, mod_dir, mod_expires, mod_deflate)

# 1. 禁止目录浏览
Options -Indexes

# 2. 默认目录索引文档
DirectoryIndex index.html

# 3. 开启重写引擎
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 3.1 强制 HTTPS 重定向 (支持反向代理前端传递的 HTTPS 头)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://jichangdaili.world/$1 [R=301,L]

  # 3.2 规范化主域名 (禁止非规范域名访问)
  RewriteCond %{HTTP_HOST} !^jichangdaili\.world$ [NC]
  RewriteRule ^(.*)$ https://jichangdaili.world/$1 [R=301,L]

  # 3.3 规范化 URL 尾斜杠: 如果不是物理文件且不带尾斜杠，301 重定向至带斜杠形式
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(.[a-zA-Z0-9]{1,5})$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://jichangdaili.world/$1/ [R=301,L]

  # 3.4 目录映射至内部 index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)/$ $1/index.html [L]

  # 3.5 真实 404 处理 (严禁把所有未匹配路径 200 回退至首页)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>

# 4. 自定义 404 错误页
ErrorDocument 404 /404.html

# 5. HTTP 缓存策略与安全标头
<IfModule mod_headers.c>
  # 5.1 HTML 页面: 允许协商缓存，确保新发布内容秒级更新
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # 5.2 带哈希指纹的静态资源 (JS/CSS/字体/图片): 开启 1 年强缓存
  <FilesMatch "\.(js|css|woff2|woff|ttf|png|jpg|jpeg|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 5.3 基础安全标头
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. Gzip / Deflate 压缩配置
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
